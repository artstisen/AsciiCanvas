<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Avalonia control and window host that display an AsciiCanvas cell grid, with two embedded monospaced fonts (Cascadia Mono and JetBrains Mono).</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Cascadia Mono (SIL OFL 1.1) is embedded so every platform renders the same default font. The icon is the default window icon. -->
    <AvaloniaResource Include="Assets\Fonts\**" />
    <AvaloniaResource Include="Assets\Icons\AsciiCanvas.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AsciiCanvas.Core\AsciiCanvas.Core.csproj" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

</Project>
