<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Metadata shared by the two library packages. The version is in the root Directory.Build.props. -->
  <PropertyGroup>
    <Authors>Lars Brandt Stisen</Authors>
    <Copyright>Copyright (c) 2026 Lars Brandt Stisen</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>ascii;tui;terminal;text-ui;grid;canvas;console;avalonia</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- The public repository, in the package, and SourceLink (built into the .NET SDK for GitHub): the symbols point at the
         source on GitHub, so a debugger steps into it -->
    <PackageProjectUrl>https://github.com/artstisen/AsciiCanvas</PackageProjectUrl>
    <RepositoryUrl>https://github.com/artstisen/AsciiCanvas</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- On GitHub Actions: deterministic paths in the symbols (/_/), no path of the build machine -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
